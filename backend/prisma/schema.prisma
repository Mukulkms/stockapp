generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BillingGroup {
  id        String    @id @default(cuid())
  name      String    @unique   // "Pulse", "Toffee", "MTR"
  products  Product[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  groupId       String
  group         BillingGroup @relation(fields: [groupId], references: [id])
  unit          String   @default("pcs")   // pcs, kg, mtr, box, ltr
  costPrice     Float    @default(0)       // latest purchase cost
  marginPercent Float?
  marginFlat    Float?
  sellingPrice  Float    @default(0)       // auto-calculated, stored for fast reads
  stockQty      Float    @default(0)

  purchaseItems PurchaseInvoiceItem[]
  salesItems    SalesInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
}

model PurchaseInvoice {
  id             String   @id @default(cuid())
  invoiceNumber  String?
  vendorName     String?
  vendorGSTIN    String?
  vendorPhone    String?
  vendorAddress  String?
  billDate       DateTime @default(now())
  imageUrl       String?
  subTotal       Float    @default(0)   // sum of qty*costPrice across items (auto-calculated)
  discountAmount Float    @default(0)
  taxAmount      Float    @default(0)
  totalAmount    Float    @default(0)   // ACTUAL final amount as printed on the bill (editable, not auto-computed)
  items          PurchaseInvoiceItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PurchaseInvoiceItem {
  id                 String   @id @default(cuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  qty                Float
  costPrice          Float

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model SalesInvoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  customerName   String?
  customerPhone  String?
  customerGSTIN  String?
  customerAddress String?
  billDate       DateTime @default(now())
  imageUrl       String?  // original hand-written bill photo, agar upload ki ho
  subTotal       Float    @default(0)   // sum of qty*rate across items (auto-calculated)
  discountAmount Float    @default(0)
  taxAmount      Float    @default(0)
  totalAmount    Float    @default(0)   // final amount actually charged (editable, not auto-computed)
  items          SalesInvoiceItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SalesInvoiceItem {
  id             String   @id @default(cuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  qty            Float
  rate           Float    // sellingPrice snapshot at time of sale
  costPrice      Float    @default(0)   // product costPrice snapshot at time of sale, for accurate profit calc even if cost later changes

  @@index([salesInvoiceId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("general")   // rent, salary, transport, misc, etc.
  amount      Float
  groupId     String?                         // optional: tie an expense to a specific company/group
  group       BillingGroup? @relation(fields: [groupId], references: [id])
  note        String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
  @@index([expenseDate])
}
